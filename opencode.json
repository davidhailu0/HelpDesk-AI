{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": [
          "node",
          "node_modules/shadcn/dist/index.js",
          "mcp"
        ],
        "timeout": {
          "startup": 60000
        }
      },
      "trail": {
        "type": "local",
        "command": [
          "trail",
          "mcp"
        ]
      }
    }
  }
}
