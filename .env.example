# ── Chat / generation provider ──────────────────────────────────────────────
# "gemini" (default) or "openai" — "openai" works with any OpenAI-compatible
# endpoint: OpenAI, OpenRouter, Groq, DeepSeek, Together, Mistral, Ollama,
# LM Studio, vLLM, ...
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# API key for the chat provider.
# - openai: required
# - gemini: you may set GEMINI_API_KEY instead
AI_API_KEY=

# Base URL of the API endpoint (only used when AI_PROVIDER=openai).
AI_BASE_URL=https://api.openai.com/v1

# Alternative for the Gemini provider:
# GEMINI_API_KEY=

# ── OpenRouter example ──────────────────────────────────────────────────────
# One key can power BOTH chat and embeddings (OpenRouter routes both through
# the same OpenAI-compatible base URL):
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=openai/gpt-4o-mini              # any "<vendor>/<model>" id
# EMBEDDING_PROVIDER=openai                # EMBEDDING_API_KEY falls back to AI_API_KEY
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Embeddings (independent from the chat provider) ─────────────────────────
# Allows e.g. an OpenAI-compatible chat model with Gemini embeddings, or vice
# versa. Defaults: EMBEDDING_PROVIDER=gemini, model text-embedding-004 (gemini)
# / text-embedding-3-small (openai).
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-004

# ── Admin panel ─────────────────────────────────────────────────────────────
# ADMIN_TOKEN=admin-secret
